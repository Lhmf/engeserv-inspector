MANAGEMENT_CODE="LHMF1218ENGSERV2026"

# Dados do primeiro Administrador Master (usados pelo script de seed)
SEED_ADMIN_NAME="Administrador Master"
SEED_ADMIN_EMAIL="admin@engeserv.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha"

