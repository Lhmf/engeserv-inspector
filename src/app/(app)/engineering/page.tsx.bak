"use client";

import { useState } from "react";
import Link from "next/link";
import { Badge } from "@/components/ui/Badge";
import { Button } from "@/components/ui/Button";
import { Card, CardContent } from "@/components/ui/Card";
import { cn } from "@/lib/utils";
import {
  Calculator,
  ChevronRight,
  CheckCircle,
  Clock,
  AlertCircle,
  Settings,
  FileText,
  History,
  ChevronDown,
  ChevronUp,
} from "lucide-react";

const CALCULATORS = [
  {
    id: "minimum-thickness",
    name: "Espessura Minima",
    description: "Calculo de espessura minima admissivel (t_min) para casco, tampos e bocais conforme ASME VIII-1, API 650, ASME I",
    standards: ["ASME VIII-1 UG-27", "UG-32", "API 650", "ASME I PG-27"],
    status: "placeholder",
    icon: Calculator,
    route: "/engineering/calculators/minimum-thickness",
  },
  {
    id: "corrosion-rate",
    name: "Taxa de Corrosao",
    description: "Calculo de taxa de corrosao (CR) entre inspecoes - duas inspecoes ou regressao linear (3+ inspecoes) conforme API 570/510",
    standards: ["API 570 7.2-7.3", "API 510 6.2-6.3", "NR-13 13.5"],
    status: "placeholder",
    icon: Calculator,
    route: "/engineering/calculators/corrosion-rate",
  },
  {
    id: "remaining-life",
    name: "Vida Util Remanescente",
    description: "Calculo de vida util remanescente baseada na espessura atual, minima admissivel e taxa de corrosao",
    standards: ["API 570 7.4", "API 510 6.4", "NR-13 13.7"],
    status: "placeholder",
    icon: Calculator,
    route: "/engineering/calculators/remaining-life",
  },
  {
    id: "mawp",
    name: "PMTA (MAWP)",
    description: "Calculo de Pressao Maxima de Trabalho Admissivel baseada na espessura atual medida",
    standards: ["ASME VIII-1 UG-27 (inv.)", "UG-32 (inv.)", "NR-13 13.5"],
    status: "placeholder",
    icon: Calculator,
    route: "/engineering/calculators/mawp",
  },
];

const STATUS_CONFIG = {
  placeholder: { label: "Placeholder", color: "bg-slate-100 text-slate-700", icon: Clock },
  validation: { label: "Em Validacao", color: "bg-amber-100 text-amber-700", icon: AlertCircle },
  validated: { label: "Validado", color: "bg-emerald-100 text-emerald-700", icon: CheckCircle },
  production: { label: "Producao", color: "bg-blue-100 text-blue-700", icon: CheckCircle },
} as const;

type StatusKey = keyof typeof STATUS_CONFIG;

export default function EngineeringPage() {
  const [expanded, setExpanded] = useState<Record<string, boolean>>({});

  return (
    <div className="max-w-6xl mx-auto space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-800">Engineering Validation</h1>
          <p className="text-sm text-slate-500 mt-1">
            Ambiente de validacao de formulas para o Engineering Engine
          </p>
        </div>
        <div className="flex items-center gap-2">
          <Badge variant="outline" className="bg-slate-50 text-slate-600">
            <Settings className="w-3 h-3 mr-1" />
            Sprint 5 - Engineering Knowledge Base
          </Badge>
        </div>
      </div>

      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        <StatCard
          title="Calculadoras"
          value={CALCULATORS.length}
          icon={Calculator}
          color="blue"
        />
        <StatCard
          title="Placeholders"
          value={CALCULATORS.filter((c) => c.status === "placeholder").length}
          icon={Clock}
          color="slate"
        />
        <StatCard
          title="Em Validacao"
          value={CALCULATORS.filter((c) => c.status === "validation").length}
          icon={AlertCircle}
          color="amber"
        />
        <StatCard
          title="Producao"
          value={CALCULATORS.filter((c) => c.status === "production").length}
          icon={CheckCircle}
          color="emerald"
        />
      </div>

      <div className="space-y-4">
        <h2 className="text-lg font-semibold text-slate-800">Calculadoras Disponiveis</h2>
        <div className="space-y-3">
          {CALCULATORS.map((calc) => (
            <CalculatorCard
              key={calc.id}
              calc={calc}
              expanded={expanded[calc.id]}
              onToggle={() => setExpanded((prev) => ({ ...prev, [calc.id]: !prev[calc.id] }))}
            />
          ))}
        </div>
      </div>

      <div className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 className="text-lg font-semibold text-slate-800 mb-4 flex items-center gap-2">
          <FileText className="w-5 h-5 text-navy" />
          Documentacao de Referencia
        </h3>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <Link
            href="/docs/ENGINEERING_INDEX.md"
            className="p-3 rounded-lg border border-slate-200 hover:border-navy hover:bg-navy/5 transition-colors"
          >
            <div className="font-medium text-slate-800">Indice Mestre (ENGINEERING_INDEX.md)</div>
            <div className="text-sm text-slate-500">Catalogo de calculos, rastreabilidade, normas</div>
          </Link>
          <Link
            href="/docs/ENGINEERING_FORMULAS.md"
            className="p-3 rounded-lg border border-slate-200 hover:border-navy hover:bg-navy/5 transition-colors"
          >
            <div className="font-medium text-slate-800">Templates de Validacao (ENGINEERING_FORMULAS.md)</div>
            <div className="text-sm text-slate-500">20 calculos com template padronizado</div>
          </Link>
          <Link
            href="/docs/engineering/"
            className="p-3 rounded-lg border border-slate-200 hover:border-navy hover:bg-navy/5 transition-colors"
          >
            <div className="font-medium text-slate-800">Base de Conhecimento (docs/engineering/)</div>
            <div className="text-sm text-slate-500">Materiais, corrosao, vida util, espessura, PMTA, etc.</            </Link>
          <Link
            href="/docs/examples/"
            className="p-3 rounded-lg border border-slate-200 hover:border-navy hover:bg-navy/5 transition-colors"
          >
            <div className="font-medium text-slate-800">Casos Reais (docs/examples/)</div>
            <div className="text-sm text-slate-500">V-101 Petrobras, V-401 Braskem, etc.
          </Link>
          <Link
            href="/docs/cases/"
            className="p-3 rounded-lg border border-slate-200 hover:border-navy hover:bg-navy/5 transition-colors"
          >
            <div className="font-medium text-slate-800">Pasta de Casos (docs/cases/)</div>
            <div className="text-sm text-slate-500">Armazenamento de casos reais EngeServ</div>
          </Link>
        </div>
      </div>
    </div>
  );
}

function StatCard({
  title,
  value,
  icon: Icon,
  color,
}: {
  title: string;
  value: number;
  icon: React.ComponentType<{ className?: string }>;
  color: string;
}) {
  const colors = {
    blue: "bg-blue-50 text-blue-700",
    slate: "bg-slate-50 text-slate-700",
    amber: "bg-amber-50 text-amber-700",
    emerald: "bg-emerald-50 text-emerald-700",
  };

  return (
    <Card className="border-slate-200">
      <CardContent className="p-4">
        <div className="flex items-center justify-between">
          <div>
            <p className="text-xs text-slate-500">{title}</p>
            <p className="text-2xl font-bold text-slate-800">{value}</p>
          </div>
          <div className={cn("p-2 rounded-lg", colors[color as keyof typeof colors] || colors.blue)}>
            <Icon className="w-5 h-5" />
          </div>
        </div>
      </CardContent>
    </Card>
  );
}

const STATUS_CONFIG = {
  placeholder: { label: "Placeholder", color: "bg-slate-100 text-slate-700", icon: Clock },
  validation: { label: "Em Validacao", color: "bg-amber-100 text-amber-700", icon: AlertCircle },
  validated: { label: "Validado", color: "bg-emerald-100 text-emerald-700", icon: CheckCircle },
  production: { label: "Producao", color: "bg-blue-100 text-blue-700", icon: CheckCircle },
} as const;

type StatusKey = keyof typeof STATUS_CONFIG;

function CalculatorCard({
  calc,
  expanded,
  onToggle,
}: {
  calc: typeof CALCULATORS[0];
  expanded: boolean;
  onToggle: () => void;
}) {
  const statusConfig = STATUS_CONFIG[calc.status];

  return (
    <Card className="border-slate-200 overflow-hidden">
      <button
        onClick={onToggle}
        className="w-full p-4 flex items-start gap-4 hover:bg-slate-50 transition-colors"
      >
        <div className="p-3 bg-navy/10 rounded-lg">
          <calc.icon className="w-6 h-6 text-navy" />
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-1">
            <h3 className="font-semibold text-slate-800">{calc.name}</h3>
            <Badge variant="outline" className={`${statusConfig.color} gap-1`}>
              <statusConfig.icon className="w-3 h-3" />
              {statusConfig.label}
            </Badge>
          </h3>
          <p className="text-sm text-slate-600 line-clamp-2">{calc.description}</p>
          <div className="flex flex-wrap gap-1 mt-2">
            {calc.standards.map((std, i) => (
              <Badge key={i} variant="outline" className="text-xs px-2 py-0.5">
                {std}
              </Badge>
            ))}
          </div>
        </div>
        <div className="flex items-center gap-3">
          <Button
            variant="outline"
            size="sm"
            asChild
          >
            <Link href={calc.route}>
              <ChevronRight className="w-4 h-4" />
              <span className="hidden sm:inline">Abrir</span>
            </Link>
          </Button>
          <button
            onClick={(e) => { e.stopPropagation(); onToggle(); }}
            className="p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition-colors"
            aria-label={expanded ? "Recolher" : "Expandir"}
          >
            {expanded ? <ChevronUp className="w-5 h-5" /> : <ChevronDown className="w-5 h-5" />}
          </button>
        </div>
      </button>

      {expanded && (
        <div className="border-t border-slate-200 bg-slate-50 p-4 space-y-3">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
            <div>
              <p className="text-xs text-slate-500 uppercase tracking-wider">Status</p>
              <p className="font-medium text-slate-800">{statusConfig.label}</p>
            </div>
            <div>
              <p className="text-xs text-slate-500 uppercase tracking-wider">Normas</p>
              <p className="font-medium text-slate-800">{calc.standards.length} referencias</p>
            </div>
            <div>
              <p className="text-xs text-slate-500 uppercase tracking-wider">Rota</p>
              <p className="font-mono text-slate-600">{calc.route}</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Button variant="outline" size="sm" asChild>
              <Link href={calc.route}>
                <ChevronRight className="w-4 h-4 mr-1" />
                Abrir Calculadora
              </Link>
            </Button>
            <Button variant="outline" size="sm">
              <History className="w-4 h-4 mr-1" />
              Historico de Validacoes
            </Button>
          </div>
        </div>
      )}
    </Card>
  );
}